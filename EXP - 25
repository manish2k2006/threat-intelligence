records = [
    {"time": 1, "hash": "A"},
    {"time": 2, "hash": "B"},
    {"time": 3, "hash": "C"}
]

valid = True

for i in range(1, len(records)):
    if records[i]["time"] < records[i-1]["time"]:
        valid = False

if valid:
    print("Chain of custody is valid")
else:
    print("Chain of custody is broken")
